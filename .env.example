# Copy this file to .env on each computer, then fill in the real values.
# Never commit .env or any access token.

# Storage: use the same URL on every computer that should share Rich data.
KE_STORAGE=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/RICH_DATABASE?sslmode=require

# AI: Rich expects an OpenAI-compatible Hermes service on this computer.
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_MODEL=qwen3.8-max
# HERMES_API_KEY=replace-if-your-Hermes-server-requires-authentication

# Keep this stable and secret when using agent capability grants.
RICH_AGENT_CAPABILITY_SECRET=replace-with-a-long-random-secret

# Optional. Rich usually discovers Codex automatically on macOS.
# KE_CODEX_BIN=/Applications/Codex.app/Contents/Resources/codex

# Optional local overrides.
# KE_DATA_DIR=/Users/your-user/Library/Application Support/Rich/data
# PORT=31515
