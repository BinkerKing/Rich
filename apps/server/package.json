{
  "name": "@ke/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:safe:db": "RUN_SAFE_DB_TESTS=1 vitest run test/projectDictionarySafeDatabase.integration.test.ts",
    "typecheck:safe-scripts": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --esModuleInterop --skipLibCheck scripts/sync-vtb-onegen-source-stage-mapping.ts scripts/import-vtb-source-test-data.ts scripts/sync-vtb-onegen-intermediate-mapping.ts",
    "typecheck": "tsc --noEmit",
    "mcp:docs": "tsx scripts/generate-mcp-v2-docs.ts",
    "mcp:benchmark": "tsx scripts/benchmark-mcp-tool-selection.ts",
    "plan": "tsx src/cli/plan.ts",
    "db:migrate:postgres": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "pm:import:dictionary": "tsx scripts/import-project-dictionary.ts",
    "pm:import:ops": "tsx scripts/import-project-ops.ts",
    "pm:normalize:dictionary-file-types": "tsx scripts/normalize-dictionary-table-file-types.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.143",
    "@hono/node-server": "^1.11.0",
    "@ke/domain": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex": "^0.130.0",
    "better-sqlite3": "^12.10.0",
    "hono": "^4.4.0",
    "mssql": "^11.0.1",
    "pg": "^8.16.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
