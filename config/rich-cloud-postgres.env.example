# Rich cloud Postgres connection template.
#
# Copy to ~/.rich-cloud-postgres.env on each Mac and fill the password.
# Do not commit the filled version in plaintext.

# Local SSH tunnel endpoint used by Rich.
RICH_DB_HOST=127.0.0.1
RICH_DB_PORT=15432

# Cloud Postgres database/user.
RICH_DB_NAME=rich
RICH_DB_USER=rich_app
RICH_DB_PASSWORD=CHANGE_ME

# Rich reads DATABASE_URL/RICH_DB_URL through the local tunnel.
RICH_DB_URL=postgresql://rich_app:CHANGE_ME@127.0.0.1:15432/rich

# SSH tunnel to the Aliyun ECS host.
RICH_DB_SSH_HOST=8.133.193.247
RICH_DB_SSH_USER=root
RICH_DB_SSH_KEY=$HOME/.ssh/rich-aliyun-ecs
